@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard</h2>
            <p class="text-muted mb-0">
                Maintenance System Overview
            </p>
        </div>

        <div class="text-muted">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </div>
    </div>


    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="card-content">
                    <div>
                        <p class="card-title">Users</p>
                        <h2>@ViewBag.UsersCount</h2>
                        <span class="card-subtitle">Registered users</span>
                    </div>

                    <div class="icon-box users-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="card-content">
                    <div>
                        <p class="card-title">Devices</p>
                        <h2>@ViewBag.DevicesCount</h2>
                        <span class="card-subtitle">Total devices</span>
                    </div>

                    <div class="icon-box devices-icon">
                        <i class="bi bi-pc-display"></i>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="card-content">
                    <div>
                        <p class="card-title">Tickets</p>
                        <h2>@ViewBag.TicketsCount</h2>
                        <span class="card-subtitle">Total tickets</span>
                    </div>

                    <div class="icon-box tickets-icon">
                        <i class="bi bi-ticket-detailed-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="card-content">
                    <div>
                        <p class="card-title">Departments</p>
                        <h2>@ViewBag.DepartmentsCount</h2>
                        <span class="card-subtitle">System departments</span>
                    </div>

                    <div class="icon-box departments-icon">
                        <i class="bi bi-building-fill"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="row g-4">

        <div class="col-xl col-md-6">
            <div class="status-card open">
                <div class="status-icon">
                    <i class="bi bi-exclamation-circle-fill"></i>
                </div>

                <div>
                    <span>Open Tickets</span>
                    <h3>@ViewBag.OpenTicketsCount</h3>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-6">
            <div class="status-card assigned">
                <div class="status-icon">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <div>
                    <span>Assigned Tickets</span>
                    <h3>@ViewBag.AssignedTicketsCount</h3>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="status-card progress">
                <div class="status-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div>
                    <span>In Progress</span>
                    <h3>@ViewBag.InProgressTicketsCount</h3>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="status-card resolved">
                <div class="status-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <span>Resolved Tickets</span>
                    <h3>@ViewBag.ResolvedTicketsCount</h3>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="status-card closed">
                <div class="status-icon">
                    <i class="bi bi-lock-fill"></i>
                </div>

                <div>
                    <span>Closed Tickets</span>
                    <h3>@ViewBag.ClosedTicketsCount</h3>
                </div>
                <div class="col-xl col-md-6">
                    <div class="status-card cancelled">
                        <div class="status-icon">
                            <i class="bi bi-x-circle-fill"></i>
                        </div>
                    </div>
                    
                </div>

                <div>
                    <span>Cancelled Tickets</span>
                    <h3>@ViewBag.CancelledTicketsCount</h3>
                </div>
            </div>
        </div>

    </div>

</div>


<style>

    .dashboard-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #e9ecef;
        transition: all 0.25s ease;
        height: 100%;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-title {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .dashboard-card h2 {
        font-size: 32px;
        font-weight: 700;
        margin: 0;
        color: #212529;
    }

    .card-subtitle {
        color: #adb5bd;
        font-size: 13px;
    }

    .icon-box {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .users-icon {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .devices-icon {
        background: #e8f8f0;
        color: #198754;
    }

    .tickets-icon {
        background: #fff3cd;
        color: #f59f00;
    }

    .departments-icon {
        background: #f0e8ff;
        color: #6f42c1;
    }


    /* Ticket Status */

    .status-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
        border: 1px solid #e9ecef;
        transition: all 0.25s ease;
        height: 100%;
    }

    .status-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.07);
    }

    .status-icon {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .status-card span {
        color: #6c757d;
        font-size: 14px;
    }

    .status-card h3 {
        margin: 4px 0 0;
        font-size: 26px;
        font-weight: 700;
        color: #212529;
    }


    /* Status Colors */

    .open .status-icon {
        background: #fff0f0;
        color: #dc3545;
    }

    .assigned .status-icon {
        background: #e8f1ff;
        color: #0d6efd;
    }

    .progress .status-icon {
        background: #fff5df;
        color: #f59f00;
    }

    .resolved .status-icon {
        background: #e8f8f0;
        color: #198754;
    }

    .closed .status-icon {
        background: #f1f3f5;
        color: #495057;
    }

    .cancelled .status-icon {
        background: #f8d7da;
        color: #dc3545;
    }


</style>