@model MaintenanceSystem.Models.Entities.Device
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var departments = ViewBag.Departments as List<MaintenanceSystem.Models.Entities.Department>;
    var users = ViewBag.Users as List<MaintenanceSystem.Models.Entities.ApplicationUser>;

    <div class="d-flex align-items-center justify-content-center" style="min-height: 90vh;">
        <div class="card shadow-sm" style="width: 100%; max-width: 450px;">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px;">
                        <i class="bi bi-hdd text-primary fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Add device</h3>
                    <p class="text-muted mb-0">Register a new device</p>
                </div>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter device name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Serial number</label>
                        <input asp-for="SerialNumber" class="form-control" placeholder="Enter serial number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <select asp-for="DepartmentId" class="form-select">
                            @foreach (var dep in departments)
                            {
                                <option value="@dep.Id">@dep.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assigned to (optional)</label>
                        <select asp-for="AssignedToUserId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var user in users)
                            {
                                <option value="@user.Id">@user.FullName</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Save</button>
                </form>
            </div>
        </div>
    </div>
}