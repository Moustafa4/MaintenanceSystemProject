<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Maintenance System</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom">
            <div class="container">

                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    Maintenance System
                </a>

                @if (Context.Session.IsLoggedIn())
                {
                    <ul class="navbar-nav flex-row me-auto ms-4">

                        @* ---------- Admin ---------- *@
                        @if (Context.Session.IsAdmin())
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Tickets" asp-action="OpenTickets">
                                    <i class="bi bi-exclamation-circle"></i> Open Tickets
                                </a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-people"></i> Users
                                </a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Department" asp-action="Index">
                                    <i class="bi bi-building"></i> Departments
                                </a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Device" asp-action="Index">
                                    <i class="bi bi-pc-display"></i> Devices
                                </a>
                            </li>
                        }

                        @* ---------- Technician ---------- *@
                        @if (Context.Session.IsTechnician())
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Tickets" asp-action="AssignedTickets">
                                    <i class="bi bi-person-check"></i> My Assigned Tickets
                                </a>
                            </li>
                        }

                        @* ---------- Employee ---------- *@
                        @if (Context.Session.IsEmployee())
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Tickets" asp-action="MyTickets">
                                    <i class="bi bi-ticket-detailed"></i> My Tickets
                                </a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link text-light" asp-controller="Tickets" asp-action="GoToCreateForm">
                                    <i class="bi bi-plus-circle"></i> New Ticket
                                </a>
                            </li>
                        }

                    </ul>

                    <span class="text-light me-3 small">
                        @Context.Session.GetUser()?.FullName
                        <span class="badge bg-dark-subtle ms-1">@Context.Session.GetUser()?.Role</span>
                    </span>

                    <form asp-controller="Account" asp-action="LogoutBtn" method="post">
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                }

            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["Error"]</div>
        }

        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>