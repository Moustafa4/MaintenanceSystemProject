    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<MaintenanceSystem.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Users</h2> 
    <a asp-action="Create" asp-controller="Users" class="btn btn-primary"> Add User </a> 
</div>



<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>

                        <td>@user.Email</td>

                        <td>@user.Department?.Name</td>

                        <td>
                            <span class="badge bg-secondary">
                                @user.Role
                            </span>
                        </td>

                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Edit
                            </a>
                            @if (user.IsActive)
                            {
                                <a asp-action="ToggleStatus" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger"> Deactivate </a>
                            }
                            else
                            {

                                <a asp-action="ToggleStatus" asp-route-id="@user.Id" class="btn btn-sm btn-outline-success"> Activate </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>
