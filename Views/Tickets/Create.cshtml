
@model MaintenanceSystem.Models.Entities.Ticket

@{
    ViewData["Title"] = "New Ticket";
}

<div class="container">

    <h2 class="mb-4">New Ticket</h2>

    <div class="card">
        <div class="card-body">

            <form asp-action="CreateBtn" method="post">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter ticket title" />
                </div>


                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Describe the problem"></textarea>
                </div>


                <div class="mb-3">
                    <label asp-for="Priority" class="form-label">
                        Priority
                    </label>

                    <select asp-for="Priority"
                            class="form-select">

                        <option value="">Select Priority</option>

                        <option value="Low">Low</option>

                        <option value="Medium">Medium</option>

                        <option value="High">High</option>

                        <option value="Critical">Critical</option>

                    </select>
                </div>


                <div class="mb-3">
                    <label asp-for="DeviceId" class="form-label">
                        Device
                    </label>

                    <select asp-for="DeviceId"
                            class="form-select">

                        <option value="">
                            Select Device
                        </option>

                        @foreach (var device in ViewBag.Devices)
                        {
                            <option value="@device.Id">
                                @device.Name - @device.SerialNumber
                            </option>
                        }

                    </select>
                </div>


                <button type="submit"
                        class="btn btn-primary">
                    Create Ticket
                </button>

                <a asp-action="MyTickets"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
