
@model MaintenanceSystem.Models.Entities.Ticket

@{
    ViewData["Title"] = "Assign Technician";
}

<div class="container">

    <h2 class="mb-4">Assign Technician</h2>

    <div class="card">
        <div class="card-body">

            <h5>@Model.Title</h5>

            <p class="text-muted">
                Device: @Model.Device?.Name
            </p>

            <hr />

            <form asp-action="AssignBtn" method="post">

                <input type="hidden"
                       name="ticketId"
                       value="@Model.Id" />

                <div class="mb-3">

                    <label class="form-label">
                        Technician
                    </label>

                    <select name="technicianId"
                            class="form-select">

                        <option value="">
                            Select Technician
                        </option>

                        @foreach (var technician in ViewBag.Technicians)
                        {
                            <option value="@technician.Id">
                                @technician.FullName
                            </option>
                        }

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Assign
                </button>

                <a asp-action="OpenTickets"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
