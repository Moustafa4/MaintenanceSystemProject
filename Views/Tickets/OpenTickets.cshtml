
@model List<MaintenanceSystem.Models.Entities.Ticket>

@{
    ViewData["Title"] = "Open Tickets";
}

<div class="container">

    <h2 class="mb-4">Open Tickets</h2>

    <div class="card">
        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Created By</th>
                        <th>Device</th>
                        <th>Department</th>
                        <th>Priority</th>
                        <th>Created At</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var ticket in Model)
                    {
                        <tr>

                            <td>@ticket.Title</td>

                            <td>@ticket.CreatedByUser?.FullName</td>

                            <td>@ticket.Device?.Name</td>

                            <td>@ticket.Department?.Name</td>

                            <td>@ticket.Priority</td>

                            <td>
                                @ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <a asp-action="Assign"
                                   asp-route-id="@ticket.Id"
                                   class="btn btn-sm btn-primary">
                                    Assign
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>
