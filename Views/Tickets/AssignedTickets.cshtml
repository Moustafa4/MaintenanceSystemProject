
@using MaintenanceSystem.Data
@model List<MaintenanceSystem.Models.Entities.Ticket>

@{
    ViewData["Title"] = "Assigned Tickets";
}

<div class="container">

    <h2 class="mb-4">Assigned Tickets</h2>

    <div class="card">
        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Created By</th>
                        <th>Device</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var ticket in Model)
                    {
                        <tr>

                            <td>@ticket.Title</td>

                            <td>@ticket.CreatedByUser?.FullName</td>

                            <td>@ticket.Device?.Name</td>

                            <td>@ticket.Priority</td>

                            <td>
                                <span class="badge bg-primary">
                                    @ticket.Status
                                </span>
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@ticket.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                @if (ticket.Status == TicketStatus.Assigned)
                                {
                                    <a asp-action="UpdateStatus"
                                       asp-route-id="@ticket.Id"
                                       asp-route-status="InProgress"
                                       class="btn btn-sm btn-warning">
                                        Start Work
                                    </a>
                                }

                                @if (ticket.Status == TicketStatus.InProgress)
                                {
                                    <a asp-action="UpdateStatus"
                                       asp-route-id="@ticket.Id"
                                       asp-route-status="Resolved"
                                       class="btn btn-sm btn-success">
                                        Resolve
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>
